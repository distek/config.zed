// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
	"icon_theme": "VSCode Icons (Dark)",
 "outline_panel": {
		"dock": "right",
		"file_icons": true,
		"folder_icons": true
	},
	"git_panel": {
		"dock": "right"
	},
	"project_panel": {
		"indent_size": 30,
		"hide_gitignore": true,
		"scrollbar": {
			"show": "always"
		},
		"default_width": 300
	},
	"search": {
		"regex": true
	},
	"features": {
		"edit_prediction_provider": "none"
	},
	"theme": "Kanagawa Dragon",
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"buffer_font_family": "FiraCode Nerd Font Mono",
	"buffer_font_features": {
		// Disable ligatures:
		"calt": false
	},
	"ui_font_family": "FiraCode Nerd Font Mono",
	"ui_font_features": {
		// Disable ligatures:
		"calt": false
	},
	"terminal": {
		"option_as_meta": true
	},
	"vim_mode": true,
	"ui_font_size": 13,
	"buffer_font_size": 13,
	"hard_tabs": true,
	"collaboration_panel": {
		"button": false
	},
	"chat_panel": {
		"button": "never"
	},
	"agent": {
		"default_model": {
			"provider": "ollama",
			"model": "deepseek-r1:14b"
		},
		"version": "2",
		"button": true
	},
	"notification_panel": {
		"button": false
	},
	"language_models": {
		"ollama": {
			"api_url": "http://192.168.1.146:11434",
			"available_models": [
				{
					"name": "qwen2.5-coder",
					"display_name": "qwen 2.5 coder 32K",
					"max_tokens": 32768,
					"supports_tools": true
				},
				{
					"name": "devstral",
					"display_name": "devstral",
					"max_tokens": 32768,
					"max_output_tokens": 4096,
					"max_completion_tokens": 1024,
					"supports_tools": true
				}
			]
		}
	}
}
